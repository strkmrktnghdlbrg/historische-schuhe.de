# historische-schuhe.de  Apache config (A2 Hosting / cPanel)
# Stand: 2026-07-01

# ---------------------------------------------------------------------------
# 1. HTTPS + non-www → www canonical
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # non-www → www
  RewriteCond %{HTTP_HOST} ^historische-schuhe\.de [NC]
  RewriteRule ^ https://www.historische-schuhe.de%{REQUEST_URI} [R=301,L]

  # Alte WordPress-/thema/-Taxonomie → neue Silo-Hubs/Artikel (301)
  RewriteRule ^thema/farbige-hosentrager/?$   /                              [R=301,L]
  RewriteRule ^thema/renaissance/?$           /renaissance-schuhe/           [R=301,L]
  RewriteRule ^thema/18-jahrhunderts/?$       /schuhe-des-18-jahrhunderts/   [R=301,L]
  RewriteRule ^thema/19-jahrhunderts/?$       /schuhe-des-19-jahrhunderts/   [R=301,L]
  RewriteRule ^thema/20-jahrhunderts/?$       /schuhe-des-20-jahrhunderts/   [R=301,L]
  RewriteRule ^thema/mittelalterliche/?$      /schuhe-im-mittelalter/        [R=301,L]
  RewriteRule ^thema/antike/?$                /epochen/                      [R=301,L]
  RewriteRule ^thema/militaerisch/?$          /epochen/                      [R=301,L]
  RewriteRule ^thema/adlig/?$                 /epochen/                      [R=301,L]
  RewriteRule ^thema/koeniglich/?$            /epochen/                      [R=301,L]
  RewriteRule ^thema/kulturen/?$              /kulturen/                     [R=301,L]
  # Silo "stil" entfaellt. Lag vorher als Meta-Refresh-Stub (HTTP 200 + noindex)
  # in src/pages/stile/ - Google wertet das nicht als Weiterleitung.
  RewriteRule ^stile/?$                       /kulturen/                     [R=301,L]
  RewriteRule ^thema/schuhe/?$                /schuhtypen/                   [R=301,L]
  RewriteRule ^thema/schuhe-kleidung/?$       /ratgeber/                     [R=301,L]
  RewriteRule ^thema/schuhmacherei/?$         /ratgeber/                     [R=301,L]
  # Alte Langslugs der 2024er-Veroeffentlichung (Arvow) auf die gekuerzten
  # Artikel-Slugs. Die Alt-URLs sind im Wayback-Archiv belegt, liefern aber 404.
  RewriteRule ^schuhe-des-20-jahrhunderts-entwicklung-der-massenproduktion/?$   /schuhe-des-20-jahrhunderts/   [R=301,L]
  RewriteRule ^schuhe-des-antiken-griechenlands-formen-und-materialien/?$   /schuhe-des-antiken-griechenlands/   [R=301,L]
  RewriteRule ^schuhe-des-19-jahrhunderts-industrielle-revolution/?$   /schuhe-des-19-jahrhunderts/   [R=301,L]
  RewriteRule ^schuhe-der-1960er-jahre-revolution-der-schuhmode/?$   /schuhe-der-1960er/   [R=301,L]
  RewriteRule ^mittelalterliche-stiefel-schuhe-funktion-und-mode/?$   /mittelalterliche-stiefel-schuhe/   [R=301,L]
  RewriteRule ^napoleonische-marschstiefel-schuhe-geschichte-und-entwicklung/?$   /napoleonische-marschstiefel-schuhe/   [R=301,L]
  RewriteRule ^tuerkische-babuschen-schuhe-einfluesse-und-mode/?$   /tuerkische-babuschen-schuhe/   [R=301,L]
  RewriteRule ^barocke-herrenschuhe-stil-und-handwerkskunst/?$   /barocke-herrenschuhe/   [R=301,L]
  RewriteRule ^schuhe-der-aegyptischen-pharaonen-status-und-symbolik/?$   /schuhe-der-aegyptischen-pharaonen/   [R=301,L]
  RewriteRule ^chinesische-lotus-schuhe-geschichte-und-bedeutung/?$   /chinesische-lotus-schuhe/   [R=301,L]
  RewriteRule ^stiefel-schuhe-im-militaer-des-19-jahrhunderts/?$   /stiefel-schuhe-19-jahrhunderts/   [R=301,L]
  RewriteRule ^schuhe-des-18-jahrhunderts-in-europa-vielfalt-und-mode/?$   /schuhe-des-18-jahrhunderts-in-europa/   [R=301,L]
  RewriteRule ^schuhe-der-1950er-jahre-beginn-der-moderne/?$   /schuhe-der-1950er-jahre/   [R=301,L]
  RewriteRule ^schuhe-des-hochmittelalters-alltag-und-adel/?$   /schuhe-des-hochmittelalters/   [R=301,L]
  RewriteRule ^japanische-geta-schuhe-tradition-und-symbolik/?$   /japanische-geta-schuhe/   [R=301,L]
  RewriteRule ^schuhe-der-1920er-jahre-stil-und-funktion/?$   /schuhe-der-1920er-jahre/   [R=301,L]
  RewriteRule ^franzoesische-hofschuhe-prunk-und-eleganz/?$   /franzoesische-hofschuhe/   [R=301,L]
  RewriteRule ^schuhe-der-1980er-jahre-einfluss-der-popkultur/?$   /schuhe-der-1980er-jahre/   [R=301,L]
  RewriteRule ^roemische-legionaersschuhe-konstruktion-und-nutzen/?$   /roemische-legionaersschuhe/   [R=301,L]
  RewriteRule ^schuhe-im-alten-rom-statussymbole/?$   /schuhe-im-alten-rom/   [R=301,L]
  RewriteRule ^schuhe-der-viktorianischen-aera-evolution-des-designs/?$   /schuhe-viktorianischen-aera/   [R=301,L]
  RewriteRule ^tuerkische-reitstiefel-schuhe-funktion-und-dekoration/?$   /tuerkische-reitstiefel-schuhe/   [R=301,L]
  RewriteRule ^renaissance-pantoffeln-schuhe-stil-und-statussymbol/?$   /renaissance-pantoffeln-schuhe/   [R=301,L]
  RewriteRule ^schuhe-des-19-jahrhunderts-mode-und-emanzipation/?$   /schuhe-des-19-jahrhunderts/   [R=301,L]
  RewriteRule ^schuhe-des-mittelalters-materialien-und-herstellung/?$   /schuhe-des-mittelalters/   [R=301,L]
  RewriteRule ^schuhe-im-mittelalter-symbolik-und-bedeutung/?$   /schuhe-im-mittelalter/   [R=301,L]
  RewriteRule ^barocke-damenschuhe-mode-und-einfluss/?$   /barocke-damenschuhe/   [R=301,L]
  RewriteRule ^barocke-schuhschnallen-schuhe-modeaccessoire-und-statussymbol/?$   /barocke-schuhschnallen-schuhe/   [R=301,L]
  RewriteRule ^antike-sandalen-schuhe-design-und-funktion/?$   /antike-sandalen-schuhe/   [R=301,L]
  RewriteRule ^renaissance-schuhe-stil-und-handwerk/?$   /renaissance-schuhe/   [R=301,L]
  RewriteRule ^indische-mojaris-schuhe-kunst-und-tradition/?$   /indische-mojaris/   [R=301,L]
  RewriteRule ^schuhe-des-18-jahrhunderts-einfluss-der-kolonialzeit/?$   /schuhe-des-18-jahrhunderts/   [R=301,L]
  RewriteRule ^roemische-sandalen-schuhe-militaerische-und-zivile-nutzung/?$   /roemische-sandalen-schuhe/   [R=301,L]

  # Catch-all fuer restliche /thema/-Pfade
  RewriteRule ^thema/                         /                              [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Gzip-Komprimierung
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching-Header
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Astro-Assets haben Content-Hash im Dateinamen → 1 Jahr cachen
  <FilesMatch "/_astro/.*\.(css|js|woff2?|jpg|jpeg|png|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder ohne Hash → 1 Woche
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|gif|ico)$">
    ExpiresDefault "access plus 1 week"
  </FilesMatch>

  # HTML → kein Cache (immer frisch)
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 4. Sicherheits-Header
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
