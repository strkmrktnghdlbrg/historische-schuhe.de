---
import AmazonBox from './AmazonBox.astro';
import asinData from '../data/amazon-asins.json';
import products from '../data/amazon-products.json';

interface Props {
  /** Gruppen-Key aus amazon-asins.json (z.B. "mittelalterschuhe") */
  group?: string;
  /** Alternativ: direkte ASIN-Liste */
  asins?: string[];
  heading?: string;
  intro?: string;
}
const { group, asins, heading, intro } = Astro.props;

const groupObj = group ? (asinData as Record<string, any>)[group] : null;
const list: string[] = asins ?? groupObj?.asins ?? [];
const title = heading ?? groupObj?.title ?? null;

// nur ASINs zeigen, zu denen es gefetchte Produktdaten gibt
const found = list.filter((a) => (products as Record<string, any>)[a]?.title);

// SearchItems liefert oft mehrere Varianten desselben Artikels (Farbe/Groesse) als
// eigene ASINs. Dedupe ueber Marke + Titelstamm, damit jedes Produkt nur einmal steht.
// Spiegelt variantKey() in scripts/fetch-amazon.mjs.
const VARIANT_WORDS = new Set(['größe','groesse','grösse','gr','eu','us','uk','numerisch','erwachsene','schuhgrößensystem','braun','dunkelbraun','hellbraun','schwarz','weiß','weiss','beige','rot','blau','grün','gruen','grau','gold','silber','bunt','brown','black','white','red','blue','green','grey','gray','dark','light','farbe','color','colour']);
function variantKey(p: any): string {
  const base = String(p.title || '')
    .split(/[(,]/)[0]              // "… Stiefel, Braun, 42" / "… (Schwarz, EU 41)" abschneiden
    .toLowerCase()
    .replace(/[^a-z0-9äöüß]+/g, ' ')
    .split(' ')
    // Groessen-, Farb- und Einzelbuchstaben-Token raus: nur sie unterscheiden Varianten
    .filter((t) => t.length > 1 && !/^\d+$/.test(t) && !VARIANT_WORDS.has(t))
    .slice(0, 6)
    .join(' ');
  return `${String(p.brand || '').toLowerCase()}|${base}`;
}
// Dedupe gilt pro SEITE, nicht pro Grid: auf der Startseite stehen zwei Grids
// untereinander, die sonst dieselbe Sandale in zwei Farben zeigen wuerden.
// Key -> ASIN (statt Set), damit ein erneutes Rendern derselben Seite im Dev-Server
// idempotent bleibt: das Grid, dem der Key gehoert, behaelt ihn.
const claimedByPage: Map<string, Map<string, string>> =
  ((globalThis as any).__amzClaimed ??= new Map());
const claimed = claimedByPage.get(Astro.url.pathname)
  ?? claimedByPage.set(Astro.url.pathname, new Map()).get(Astro.url.pathname)!;

const available = found.filter((a) => {
  const key = variantKey((products as Record<string, any>)[a]);
  const owner = claimed.get(key);
  if (owner && owner !== a) return false; // Variante eines Produkts, das schon auf der Seite steht
  claimed.set(key, a);
  return true;
});
---
{available.length > 0 && (
  <section class="amzgrid-wrap">
    {title && (
      <div class="amzgrid-head">
        <h3>{title}</h3>
        {intro && <p>{intro}</p>}
      </div>
    )}
    <div class="amzgrid">
      {available.map((asin) => <AmazonBox asin={asin} />)}
    </div>
    <p class="amzgrid-disc">Anzeige / Affiliate-Links: Kaufst du über diese Links, erhalten wir als Amazon-Partner eine Provision. Für dich entstehen keine Mehrkosten. Preise und Verfügbarkeit können abweichen, es gilt der auf Amazon angezeigte Preis.</p>
  </section>
)}

<style>
  .amzgrid-wrap { margin: 40px 0; }
  .amzgrid-head { margin-bottom: 22px; }
  .amzgrid-head h3 { font-size: 28px; letter-spacing: -0.01em; color: var(--ink); font-family: 'Cormorant Garamond', Georgia, serif; }
  .amzgrid-head p { color: #5a4634; font-size: 16px; margin-top: 6px; }
  .amzgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .amzgrid-disc { font-size: 12px; color: var(--muted); line-height: 1.5; margin-top: 16px; }
</style>
