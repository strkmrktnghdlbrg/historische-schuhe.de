---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmazonBoxGrid from '../components/AmazonBoxGrid.astro';

// Beratung nach Nutzungsprofil, nicht nach Schuhtyp. Der haeufigste Fehlkauf in
// dieser Nische entsteht, weil zuerst das Modell gewaehlt wird und danach der
// Zweck dazu erfunden. Keine Scores, keine Messwerte, keine Testbehauptungen.
const profile = [
  {
    key: 'authentisch',
    wer: 'Reenactment & Living History',
    frage: 'Die Darstellung soll einer Prüfung standhalten.',
    empfehlung: 'Wendegenähter Bundschuh oder Wendeschuh',
    emoji: '👞',
    warum: 'Wendegenäht ist die historisch belegte Machart. Naturfarbenes, pflanzlich gegerbtes Leder, dünne flache Ledersohle, kein Absatz, keine sichtbare Rahmennaht.',
    achte: ['Naht darf außen nicht querlaufen', 'Naturfarben statt Schwarz', 'Ledersohle ohne Profil'],
    preis: 'ab ca. 60 €',
    link: '/bundschuhe/',
    linkLabel: 'Zum Bundschuh-Ratgeber',
  },
  {
    key: 'larp',
    wer: 'LARP & Geländespiel',
    frage: 'Der Schuh muss drei Tage Wald überstehen.',
    empfehlung: 'Geschnürter Lederstiefel',
    emoji: '🥾',
    warum: 'Hier zählt Haltbarkeit vor Fundtreue. Ein höherer Schaft schützt Knöchel und Wade, eine feste Sohle trägt über Wurzeln und nassen Boden.',
    achte: ['Kräftiges Leder, gut vernähter Schaft', 'Feste, griffige Sohle', 'Schaftweite passend zur Wade'],
    preis: 'ab ca. 80 €',
    link: '/mittelalterliche-stiefel-schuhe/',
    linkLabel: 'Zu den Mittelalterstiefeln',
    top: true,
  },
  {
    key: 'einsteiger',
    wer: 'Erster Mittelaltermarkt',
    frage: 'Ein Wochenende, begrenztes Budget, noch keine feste Darstellung.',
    empfehlung: 'Schlichter Lederschuh in Dunkelbraun',
    emoji: '🩴',
    warum: 'Ein schlichtes, naturfarbenes Modell passt zu fast jeder Epoche und fällt nie negativ auf. Authentizität lässt sich später steigern, ein schmerzender Fuß ruiniert den ersten Markt sofort.',
    achte: ['Bequemlichkeit vor Fundtreue', 'Einlegesohle einplanen', 'Rückgabe prüfen'],
    preis: 'ab ca. 40 €',
    link: '/schuhe-erster-mittelaltermarkt-einsteiger/',
    linkLabel: 'Zum Einsteiger-Guide',
  },
];

const faq = [
  {
    q: 'Welcher Mittelalterschuh ist der richtige für mich?',
    a: 'Das hängt am Einsatz, nicht am Modell. Für Reenactment und Living History ist ein wendegenähter Bundschuh die historisch belegte Wahl. Für LARP und Geländespiel ist ein geschnürter Lederstiefel haltbarer. Für den ersten Mittelaltermarkt ist ein schlichter, dunkelbrauner Lederschuh die sicherste Wahl, weil er zu fast jeder Darstellung passt.',
  },
  {
    q: 'Was kosten gute Mittelalterschuhe?',
    a: 'Einfache Lederschuhe beginnen bei etwa 40 bis 60 Euro. Wendegenähte Modelle und robuste Stiefel liegen meist zwischen 80 und 150 Euro. Handgefertigte Repliken von Spezialanbietern kosten deutlich mehr. Preise und Verfügbarkeit ändern sich laufend, es gilt immer der Preis beim Händler.',
  },
  {
    q: 'Sind Mittelalterschuhe mit Gummisohle authentisch?',
    a: 'Nein. Eine profilierte Gummisohle, ein sichtbarer Absatz und eine außen umlaufende Rahmennaht gehören alle in spätere Jahrhunderte. Für Markt und LARP sind solche Modelle trotzdem oft die praktischere Wahl, man sollte sie nur nicht für historisch korrekt halten.',
  },
  {
    q: 'Welche Größe soll ich bei Mittelalterschuhen bestellen?',
    a: 'Historisch gearbeitete Schuhe fallen anders aus als Konfektionsware und weiten sich beim Tragen merklich. Miss den Fuß in Zentimetern und gleiche mit der Größentabelle des Herstellers ab, statt der gewohnten Nummer zu vertrauen. Plane Platz für einen dicken Wollstrumpf ein.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Schuhtypen', item: new URL('/schuhtypen/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: 'Mittelalterschuhe im Vergleich', item: new URL('/mittelalterschuhe-vergleich/', Astro.site).href },
  ],
};
---
<BaseLayout
  title="Mittelalterschuhe im Vergleich 2026: Welcher passt zu deinem Einsatz? | historische-schuhe.de"
  description="Bundschuh, Lederstiefel oder schlichter Markt-Schuh? Die Kaufberatung nach Einsatzzweck statt nach Modell, mit ehrlicher Einordnung von Authentizitaet, Haltbarkeit und Preis."
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <section style="padding:52px 0 8px">
    <div class="wrap" style="max-width:860px">
      <span class="eyebrow">Kaufberatung</span>
      <h1 style="font-size:48px;margin:12px 0 16px;line-height:1.05">Mittelalterschuhe im Vergleich</h1>

      <div class="answer-lead">
        <p><strong>Die Wahl entscheidet sich am Einsatz, nicht am Modell.</strong> Für Reenactment ist ein wendegenähter Bundschuh richtig, für LARP ein geschnürter Lederstiefel, für den ersten Markt ein schlichter dunkelbrauner Lederschuh. Der häufigste Fehlkauf entsteht, weil zuerst das Modell ausgesucht und dann die Darstellung dazu erfunden wird.</p>
      </div>

      {/* Vergleichsmodul direkt unter der Antwort: Bei einer Vergleichsquery ist
          die Gegenueberstellung selbst das Centerpiece, nicht Fliesstext darueber. */}
      <div class="tablewrap cmp-table">
        <table>
          <thead>
            <tr><th>Einsatz</th><th>Empfehlung</th><th>Preis ab</th></tr>
          </thead>
          <tbody>
            {profile.map((p) => (
              <tr>
                <td>{p.wer}</td>
                <td><a href={p.link}>{p.empfehlung}</a></td>
                <td>{p.preis.replace('ab ca. ', '')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="aff-banner">Anzeige: Diese Seite enthält Affiliate-Links. Kaufst du über einen markierten Link, erhalten wir ggf. eine kleine Provision. Für dich bleibt der Preis gleich. Die Einordnung nach Einsatzzweck ist eine redaktionelle Empfehlung, kein Test und kein Ranking. Preise und Verfügbarkeit ändern sich, prüfe sie immer direkt beim Händler.</div>
    </div>
  </section>

  <section style="padding-top:34px">
    <div class="wrap">
      <div class="vgrid">
        {profile.map((p) => (
          <article class={`pcard${p.top ? ' top' : ''}`}>
            {p.top && <span class="ribbon">★ Vielseitigste Wahl</span>}
            <div class="pthumb">{p.emoji}</div>
            <div class="pbody">
              <span class="pcat">{p.wer}</span>
              <h3>{p.empfehlung}</h3>
              <p class="pfrage">{p.frage}</p>
              <p class="pwarum">{p.warum}</p>
              <span class="plabel">Worauf du achtest</span>
              <ul class="pros">
                {p.achte.map((t) => <li class="pro">{t}</li>)}
              </ul>
              <span class="ppreis">{p.preis}</span>
              <a href={p.link} class="btn btn-primary">{p.linkLabel} →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="aff-note">* Affiliate-Links (Anzeige). Als Amazon-Partner verdienen wir an qualifizierten Verkäufen. Preisangaben sind Orientierungswerte für gängige Modelle, keine Testergebnisse.</p>
    </div>
  </section>

  <section id="amazon-modelle" style="padding-top:0;scroll-margin-top:90px">
    <div class="wrap" style="max-width:1100px">
      <AmazonBoxGrid group="mittelalterschuhe" heading="Beliebte Mittelalterschuhe bei Amazon" intro="Aktuelle Modelle und Preise direkt von Amazon, automatisch aktualisiert." />
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="wrap" style="max-width:860px">
      <div class="prose">
        <h2>Die drei Fragen vor dem Kauf</h2>

        <h3>1. Authentizität oder Alltagstauglichkeit?</h3>
        <p>Wendegenähte Schuhe sind glaubwürdig, weil sie der historischen Machart entsprechen. Ihre dünne Sohle ist auf weichem Waldboden angenehm, auf Asphalt oder Kopfsteinpflaster nach ein paar Stunden aber wenig gedämpft. Wer viel steht oder läuft, fährt mit einer dezenten Einlegesohle oder einem robusteren Stiefel besser. Was die Machart genau bedeutet, steht im Ratgeber zu <a href="/wendegenaehte-schuhe-erklaert/">wendegenähten Schuhen</a>.</p>

        <h3>2. Welche Epoche stellst du dar?</h3>
        <p>"Mittelalter" umfasst rund tausend Jahre. Ein früher Wendeschuh und ein spätgotischer <a href="/schnabelschuhe/">Schnabelschuh</a> haben wenig gemeinsam. Wer die Epoche zuerst festlegt, findet die Schuhform fast von selbst. Die Übersicht dazu steht bei den <a href="/schuhe-im-mittelalter/">Schuhen im Mittelalter</a>.</p>

        <h3>3. Passt die Größe wirklich?</h3>
        <p>Historisch gearbeitete Schuhe fallen anders aus als Konfektionsware und laufen sich merklich weiter. Miss den Fuß, statt der gewohnten Nummer zu vertrauen, und plane Platz für einen dicken Wollstrumpf ein. Die Fallstricke stehen im <a href="/schuhgroesse-passform-historische-schuhe/">Passform-Ratgeber</a>, die Pflege danach im <a href="/leder-pflegen-historische-schuhe/">Pflege-Ratgeber</a>.</p>

        <p>Du bist dir bei der Bezugsquelle unsicher? Im <a href="/beste-shops-apps-historische-schuhe-kaufen/">Shop- und App-Vergleich</a> zeigen wir, wo du historische Schuhe mit guter Auswahl und einfacher Rückgabe kaufst. Wer den Schuh lieber selbst baut, findet die Schritte in der Anleitung zum <a href="/schuhe-selber-machen-mittelalter/">Schuhe selber machen</a>.</p>

        <h2>Häufige Fragen</h2>
        {faq.map((f) => (
          <>
            <p><strong>{f.q}</strong> {f.a}</p>
          </>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .answer-lead{background:var(--linen);border:1px solid var(--line);border-left:3px solid var(--brass);
    border-radius:12px;padding:18px 22px;margin:0 0 20px;font-size:18px;line-height:1.65;color:#42342a}
  .answer-lead p{margin:0}
  .answer-lead strong{color:var(--ink)}
  .aff-banner{margin-top:22px;background:rgba(176,138,62,.12);border:1px solid var(--line);border-radius:10px;padding:13px 16px;font-size:13px;color:#6a5440}
  .cmp-table{overflow-x:auto;margin:0 0 4px;-webkit-overflow-scrolling:touch}
  .cmp-table table{width:100%;border-collapse:collapse;font-size:15px}
  .cmp-table th,.cmp-table td{border:1px solid var(--line);padding:10px 12px;text-align:left;vertical-align:top}
  .cmp-table th{background:var(--parchment-2);color:var(--ink);white-space:nowrap;font-family:'Inter';font-size:13px}
  .cmp-table a{color:var(--oxblood);text-decoration:underline;text-underline-offset:3px}
  .pfrage{font-size:13.5px;color:#6a5440;font-style:italic;margin:6px 0 10px}
  .pwarum{font-size:14.5px;color:#42342a;line-height:1.6;margin:0 0 12px}
  .plabel{display:block;font-family:'Inter';font-size:11px;font-weight:700;text-transform:uppercase;
    letter-spacing:.08em;color:var(--brass);margin-bottom:8px}
  .ppreis{display:inline-block;background:rgba(176,138,62,.14);color:#7a5c22;font-size:12.5px;
    font-weight:600;padding:4px 10px;border-radius:999px;margin:4px 0 12px}
  .vgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}
  @media(max-width:900px){.vgrid{grid-template-columns:1fr}}
</style>
